DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
AUTH_SECRET="generate with: node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""

# Optional. Only set these on a public DEMO deployment (e.g. a marketplace
# preview) — when set, a copy-paste admin login banner shows up on the
# homepage and login page. Leave unset on a real deployment; no banner
# renders and no credentials are exposed to visitors.
# NEXT_PUBLIC_DEMO_ADMIN_EMAIL="demo-admin@example.com"
# NEXT_PUBLIC_DEMO_ADMIN_PASSWORD="demo-password"
